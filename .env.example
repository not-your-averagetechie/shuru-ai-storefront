# Required: Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: reads public Instagram profiles. Without it the app asks creators to describe themselves.
APIFY_TOKEN=

# Optional: Upstash Redis (added automatically by the Vercel marketplace integration).
# Without these, local dev stores data in .data/db.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional overrides
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_FALLBACK_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=low
